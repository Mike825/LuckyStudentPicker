<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LuckyStudentPicker.SeatArrangerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LuckyStudentPicker"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    >

    <Grid Loaded="Grid_Loaded">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical" Margin="32, 32, 32, 0">
                <InfoBar IsOpen="True" Severity="Warning" Title="Notice" Message="Capture it before you leave or it will be lost FOREVER. " IsClosable="True"></InfoBar>
                <StackPanel Margin="20" Spacing="50" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Grid Name="SeatGrid"
                            HorizontalAlignment="Center"
                            Margin="0,20,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Orientation="Vertical">
                        <Button Name="RandomizeButton"
                                Content="🎲 Randomize"
                                Click="RandomizeButton_Click"
                                Style="{StaticResource AccentButtonStyle}"
                                Width="180"
                                Padding="20,12"
                                FontSize="16"
                                FontWeight="SemiBold">
                            <Button.Resources>
                                <ResourceDictionary>
                                    <ResourceDictionary.ThemeDictionaries>
                                        <ResourceDictionary x:Key="Default">
                                            <SolidColorBrush x:Key="AccentButtonBackground" Color="#667eea"/>
                                            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#5a6fd8"/>
                                            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#4e63c6"/>
                                        </ResourceDictionary>
                                    </ResourceDictionary.ThemeDictionaries>
                                </ResourceDictionary>
                            </Button.Resources>
                        </Button>
                        <Button Name="CaptureButton"
                                Click="CaptureButton_Click"
                                Padding="20, 12"
                                Width="180"
                                FontSize="16"
                                FontWeight="SemiBold">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📸 Capture" FontSize="16" FontWeight="SemiBold"></TextBlock>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        <Button Name="OpenCaptureFolderButton"
                                Click="OpenCaptureFolderButton_Click"
                                Padding="20, 12"
                                Width="180"
                                FontSize="16"
                                FontWeight="SemiBold"
                                >
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📂 Open folder" FontSize="16" FontWeight="SemiBold"></TextBlock>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
