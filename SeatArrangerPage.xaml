<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LuckyStudentPicker.SeatArrangerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LuckyStudentPicker"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    >

    <Grid Loaded="Grid_Loaded">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical" Margin="32, 32, 32, 0">
                <StackPanel Margin="20" Spacing="50" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Grid Name="SeatGrid"
                            HorizontalAlignment="Center"
                            Margin="0,20,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Orientation="Vertical">
                        <TextBlock Name="RandomizeTimesIndicator" Text="0" FontSize="36" FontWeight="Bold" Margin="0,0,0,16" HorizontalAlignment="Center"></TextBlock>
                        <Button Name="RandomizeButton"
                                Content="🎲 Randomize"
                                Click="RandomizeButton_Click"
                                Style="{StaticResource AccentButtonStyle}"
                                Width="180"
                                Padding="20,12"
                                FontSize="16"
                                FontWeight="SemiBold">
                            <Button.Resources>
                                <ResourceDictionary>
                                    <ResourceDictionary.ThemeDictionaries>
                                        <ResourceDictionary x:Key="Default">
                                            <SolidColorBrush x:Key="AccentButtonBackground" Color="#667eea"/>
                                            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#5a6fd8"/>
                                            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#4e63c6"/>
                                        </ResourceDictionary>
                                    </ResourceDictionary.ThemeDictionaries>
                                </ResourceDictionary>
                            </Button.Resources>
                            <Button.ContextFlyout>
                                <Flyout Placement="Top" x:Name="RandomizingTimesFlyout">
                                    <StackPanel Orientation="Vertical" Spacing="8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Randomize" Margin="0,0,8,0" FontSize="16" VerticalAlignment="Center"></TextBlock>
                                            <NumberBox Loaded="RandomizingTimes_Loaded" Name="RandomizingTimes" ValidationMode="InvalidInputOverwritten" Value="1" VerticalAlignment="Center" SpinButtonPlacementMode="Hidden" AcceptsExpression="False" SmallChange="1" FontSize="16" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display"></NumberBox>
                                            <TextBlock Text="times in a row" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="16"></TextBlock>
                                        </StackPanel>
                                        <InfoBar IsClosable="False" IsOpen="False" Loaded="RandomizeTimesErrorPrompt_Loaded" Name="RandomizeTimesErrorPrompt" Severity="Error" Title="Error" Message="Please input a valid number (1 ~ 50)"></InfoBar>
                                    </StackPanel>
                                </Flyout>
                            </Button.ContextFlyout>
                        </Button>
                        <Button Name="ResetButton"
                                Click="ResetButton_Click"
                                Padding="20, 12"
                                Width="180"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Content="🔄️ Reset">
                        </Button>
                        <Button Name="CaptureButton"
                                Click="CaptureButton_Click"
                                Padding="20, 12"
                                Width="180"
                                FontSize="16"
                                FontWeight="SemiBold">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📸 Capture" FontSize="16" FontWeight="SemiBold"></TextBlock>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        <Button Name="OpenCaptureFolderButton"
                                Click="OpenCaptureFolderButton_Click"
                                Padding="20, 12"
                                Width="180"
                                FontSize="16"
                                FontWeight="SemiBold"
                                >
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📂 Open folder" FontSize="16" FontWeight="SemiBold"></TextBlock>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
