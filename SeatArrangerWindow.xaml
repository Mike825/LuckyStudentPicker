<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LuckyStudentPicker.SeatArrangerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LuckyStudentPicker"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Seat Arranger"
    >
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid x:Name="SeatArrangerWindowTitleBar">
            <Image Source="/Assets/program.ico"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Width="20" Height="20"
                   Margin="16, 16"
                   Grid.Column="0"/>

            <TextBlock x:Name="AppTitleTextBlock" Text="Seat Arranger"
                       TextWrapping="NoWrap"
                       FontSize="20"
                       VerticalAlignment="Top"
                       Margin="48, 10, 28, 28"
                       Grid.Column="1"/>
        </Grid>

        <NavigationView x:Name="SeatArrangerNV" Margin="0, 48, 0, 0" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsPaneOpen="False" ItemInvoked="SeatArrangerNV_ItemInvoked" Loaded="SeatArrangerNV_Loaded">
            <NavigationView.MenuItems>
                <NavigationViewItem Icon="Shuffle" Content="Seat Arranger" Tag="SeatArrangerPage">
                </NavigationViewItem>
                <NavigationViewItem Content="Information" Tag="SeatArrangerInformationPage">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="SeatArrangerSettingsPage">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Frame x:Name="SeatArrangerContentFrame"/>
        </NavigationView>
    </Grid>
</Window>
